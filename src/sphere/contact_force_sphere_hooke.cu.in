#include <onika/scg/operator.h>
#include <onika/scg/operator_slot.h>
#include <onika/scg/operator_factory.h>

#include <exanb/core/make_grid_variant_operator.h>
#include <exanb/core/parallel_grid_algorithm.h>
#include <exanb/core/grid.h>
#include <exanb/core/domain.h>
#include <exanb/core/xform.h>


#include <exaDEM/forcefield/contact_parameters.hpp>
#include <exaDEM/forcefield/contact_force.hpp>
#include <exaDEM/forcefield/multimat_parameters.hpp>
#include <exaDEM/drivers.hpp>
#include <exaDEM/sphere/contact_force_sphere_common.hpp>
#include <exaDEM/sphere/contact_sphere.hpp>
#include <exaDEM/interaction/grid_cell_interaction.hpp>
#include <exaDEM/classifier/classifier.hpp>
#include <exaDEM/classifier/classifier_for_all.hpp>
#include <exaDEM/itools/itools.hpp>
#include <exaDEM/shapes.hpp>
#include <exaDEM/shape_detection.hpp>
#include <exaDEM/shape_detection_driver.hpp>

namespace exaDEM {
/**
 * Contact forces between spheres, and between spheres and drivers, with the Hooke contact law
 * (ContactParams). See contact_force_sphere_hertz.cu.in for the Hertz law.
 */
template <bool multimat, CohesiveLawType CohesiveLaw, typename GridT,
          class = AssertGridHasFields<GridT, field::_vx, field::_vy, field::_vz, field::_mom, field::_orient,
                                      field::_vrot, field::_radius>>
class ComputeContactClassifierSphereHooke : public OperatorNode {
  // attributes processed during computation
  using ComputeFields = FieldSet<field::_vrot, field::_arot>;
  static constexpr ComputeFields compute_field_set{};

  static constexpr ContactLawType ContactLaw = ContactLawType::Hooke;
  using ContactParamsT = ContactParams;

  ADD_SLOT(GridT, grid, INPUT_OUTPUT, REQUIRED);
  ADD_SLOT(Domain, domain, INPUT, REQUIRED);
  ADD_SLOT(ContactParams, config, INPUT, OPTIONAL, DocString{"Contact parameters for sphere interactions"});
  ADD_SLOT(ContactParams, config_driver, INPUT, OPTIONAL, DocString{"Contact parameters for drivers, optional"});
  ADD_SLOT(MultiMatParamsT<ContactParams>, multimat_cp, INPUT, OPTIONAL,
           DocString{"List of contact parameters for simulations with multiple materials, see multimat_contact_params and drivers_contact_params"});
  ADD_SLOT(double, dt, INPUT, REQUIRED, DocString{"Time step value"});
  ADD_SLOT(Drivers, drivers, INPUT, REQUIRED, DocString{"List of Drivers {Cylinder, Surface, Ball, Mesh}"});
  ADD_SLOT(Classifier, ic, INPUT_OUTPUT, DocString{"Interaction lists classified according to their types"});
  // analysis
  ADD_SLOT(long, timestep, INPUT, REQUIRED);
  ADD_SLOT(long, analysis_interaction_dump_frequency, INPUT, REQUIRED, DocString{"Write an interaction dump file"});
  ADD_SLOT(std::string, dir_name, INPUT, REQUIRED, DocString{"Output directory name."});
  ADD_SLOT(std::string, interaction_basename, INPUT, REQUIRED,
           DocString{"Write an Output file containing interactions."});
  // private
  ADD_SLOT(bool, print_warning, PRIVATE, true,
           DocString{"This variable is used to ensure that warning messages are displayed only once."});
  // output
  ADD_SLOT(double, max_kn, INPUT_OUTPUT, 0,
           DocString{"Get the highest value of the input contact force parameters kn (used for dt_critical)"});

 public:
  inline std::string opertor_name() {
    return "contact_sphere";
  }

  inline std::string documentation() const final {
    return R"EOF(
      This operator computes forces between particles and particles/drivers using the contact law.
      Note that to use multmaterials version, you need to predefine the parameters with multimat_contact_params and drivers_contact_params.  

      Naming system :
      contact_[InputType]_[Shape]_[ContactLaw]_[CohesiveLaw]
      [InputType]   : singlemat or multimat
      [Shape]       : sphere or polyhedron
      [ContactLaw]  : Hooke (this operator) or Hertz (spheres only, see contact_sphere_hertz_[CohesiveLaw])
      [CohesiveLaw] : None or Cohesive or DMT
      For simplicity contact_sphere <=> contact_singlemat_sphere_hooke <=> contact_singlemat_sphere_hooke_none
      The contact law is always symetric: each interaction is computed once, for both particles (nbh_sphere builds
      symetric interactions).

      YAML example:
        - contact_sphere:
           config: { kn: 100000, kt: 100000, kr: 0.1, mu: 0.9, damp_rate: 0.9}

        - contact_singlemat_sphere_hooke:
           config: { kn: 100000, kt: 100000, kr: 0.1, mu: 0.9, damp_rate: 0.9}

        - contact_singlemat_sphere_hooke_cohesive:
           config: { dncut: 0.1 m, kn: 100000, kt: 100000, kr: 0.1, fc: 0.05, mu: 0.9, damp_rate: 0.9}

        - contact_singlemat_sphere_hooke_dmt:
           config: { dncut: 0.1 m, kn: 100000, kt: 100000, kr: 0.1, mu: 0.9, damp_rate: 0.9, gamma: 0.05}

        - contact_multimat_sphere_hooke_none

        - contact_multimat_sphere_hooke_dmt

        - contact_multimat_sphere_hooke_cohesive

      )EOF";
  }

  template <typename XFormT>
  void core(XFormT& xform) {
    // the contact laws of spheres are always symetric: each interaction is computed once, for both particles
    constexpr bool is_sym = true;
    auto exec_ctx = [this]() { return this->parallel_execution_context(); };
    const DriversGPUAccessor drvs = *drivers;
    auto* cells = grid->cells();
    const double time = *dt;
    auto& classifier = *ic;

    if constexpr (!multimat) {
      const ContactParamsT hkp = *config;
      ContactParamsT hkp_drvs{};
      if (drivers->get_size() > 0) {
        hkp_drvs = *config_driver;
      }
      const SingleMatContactParamsTAccessor<ContactParamsT> cp = {hkp};
      const SingleMatContactParamsTAccessor<ContactParamsT> cp_drvs = {hkp_drvs};
      sphere::run_sphere_contact_laws<is_sym, ContactLaw, CohesiveLaw>(exec_ctx, classifier, xform, cells, drvs, cp,
                                                                       cp_drvs, time);
    } else {
      const auto& contact_parameters = *multimat_cp;
      const MultiMatContactParamsTAccessor<ContactParamsT> cp = contact_parameters.get_multimat_accessor();
      const MultiMatContactParamsTAccessor<ContactParamsT> cp_drvs = contact_parameters.get_drivers_accessor();
      sphere::run_sphere_contact_laws<is_sym, ContactLaw, CohesiveLaw>(exec_ctx, classifier, xform, cells, drvs, cp,
                                                                       cp_drvs, time);
    }
  }

  /** Analysis */
  void save_results() {
    sphere::save_interactions(*grid, *ic, *timestep, *analysis_interaction_dump_frequency, *dir_name,
                              *interaction_basename);
  }

  void check_slots() {
    bool pw = true;
    constexpr auto LawCombo = makeLawCombo(ContactLaw, CohesiveLaw);
    /** polyhedron interactions are defined while the contact sphere operator is used */
    sphere::check_no_polyhedron_interactions(*ic, opertor_name());

    /** Some check mutlimat versus singlemat */
    if constexpr (multimat) {
      if (!multimat_cp.has_value()) {
        std::string msg =
            "You are using the multi-material contact force model, but the contact law parameters have not been "
            "defined.\n";
        msg += "Please specify the parameter values for each material pair using the operator \"multimat_contact_params\".";
        color_log::error(opertor_name(), msg);
      }

      if (*print_warning && config.has_value()) {
        color_log::warning(
            opertor_name(),
            "You are using the multi-material contact force operator, but you have also defined the input slot "
            "\"config\" which is intended for the single-material version. This slot will be ignored.");
        pw = false;
      }

      if (*print_warning && config_driver.has_value()) {
        color_log::warning(
            opertor_name(),
            "You are using the multi-material contact force operator, but you have also defined the input slot "
            "\"config_driver\" which is intended for the single-material version. This slot will be ignored.");
        pw = false;
      }
    }

    if constexpr (!multimat) {
      if (!config.has_value()) {
        std::string msg =
            "The input slot \"config\" is not defined, yet the single-material version of the contact operator is "
            "being used.\n";
        msg += "Please specify the \"config\" input slot, and use the \"config_driver\" slot";
        msg += " if you want to define a contact law between a particle and a driver.";
        color_log::error(opertor_name(), msg);
      }

      if (multimat_cp.has_value()) {
        std::string msg = " You have defined a list of contact law parameters for different material types, \n";
        msg +=
            "but you are using the version that only considers the parameter defined in the \"config\" input slot.\n";
        msg += "The parameter list will be ignored. If you want to use it, please use the operators types \n";
        msg += "\"contact_multimat_[Shape]_[ContactLaw]_[CohesiveLaw]\".";
        color_log::warning(opertor_name(), msg);
        pw = false;
      }
      /** Some global checks */
      /** Is cohesive force define while it's not used */
      if constexpr (!LawComboTraits<LawCombo>::cohesive) {
        if (config->dncut_ > 0) {
          color_log::error(opertor_name(),
                           "dncut is != 0 while the cohesive force is not used. Please, use "
                           "contact_[InputType]_[Shape]_hooke_cohesive operators.");
        }

        if (drivers->get_size() > 0 && config_driver->dncut_ > 0) {
          color_log::error(opertor_name(),
                           "dncut is != 0 while the cohesive force is not used. Please, use "
                           "contact_[InputType]_[Shape]_hooke_cohesive operators.");
        }
      }
    }
    *print_warning = pw;
  }

  /** fill highest kn */
  void scan_kn() {
    if (!(*print_warning)) {
      return;
    }

    double kn = 0.0;
    if (config.has_value()) {
      kn = std::max(kn, config->kn_);
    }

    if (config_driver.has_value()) {
      kn = std::max(kn, config_driver->kn_);
    }

    if (multimat_cp.has_value()) {
      auto get_max_kn = [&kn](const ContactParams& cp) -> void { kn = std::max(kn, cp.kn_); };
      multimat_cp->apply(get_max_kn);
    }
    *max_kn = kn;
  }

  inline void execute() final {
    check_slots();
    scan_kn();

    if (grid->number_of_cells() == 0) {
      return;
    }

    if (!domain->xform_is_identity()) {
      LinearXForm cp_xform = {domain->xform()};
      core(cp_xform);
    } else {
      NullXForm cp_xform;
      core(cp_xform);
    }
    save_results();
  }
};

// ComputeContactSingleMatSphereHooke = CCSMSH
// ComputeContactMultiMatSphereHooke = CCMMSH

template <class GridT>
using CCSMSHNoneTmpl = ComputeContactClassifierSphereHooke<false, CohesiveLawType::None, GridT>;
template <class GridT>
using CCSMSHDmtTmpl = ComputeContactClassifierSphereHooke<false, CohesiveLawType::DMT, GridT>;
template <class GridT>
using CCSMSHCohesiveTmpl = ComputeContactClassifierSphereHooke<false, CohesiveLawType::Cohesive, GridT>;

template <class GridT>
using CCMMSHNoneTmpl = ComputeContactClassifierSphereHooke<true, CohesiveLawType::None, GridT>;
template <class GridT>
using CCMMSHDmtTmpl = ComputeContactClassifierSphereHooke<true, CohesiveLawType::DMT, GridT>;
template <class GridT>
using CCMMSHCohesiveTmpl = ComputeContactClassifierSphereHooke<true, CohesiveLawType::Cohesive, GridT>;

// === register factories ===
ONIKA_AUTORUN_INIT(contact_force_sphere_@LAW@_@MODEL@_@MAT@)  // see CMakeLists.txt
{
  @REGISTRATIONS@
}
}  // namespace exaDEM
