######### POLYHEDRA mode ####################

save_shapes: write_shape_file
do_update_persistent_interactions_if_required: nop # overight if config_fragmentation is included

evaluate_particle_displ:
  rebind: { threshold: max_displ , result: particle_displ }
  body: 
    - vertex_displ_over

chunk_neighbors_search:
  - nbh_polyhedron_auto
  - update_interaction_ghost
#  - check_owner_partner_ghosts
  - classify_interactions_auto
#  - check_owner_partner_ghosts

chunk_neighbors_impl:
  - chunk_neighbors_contact_cpu_only
  - chunk_neighbors_search

migrate_particles:
  - migrate_cell_particles_interaction
  - rebuild_amr
  - backup_dem

cost_model: dem_cost_model

move_particles_extra_data: move_particles_interaction

compute_new_vertices: 
  - do_update_persistent_interactions_if_required # a nop unless config_fragmentation is included
  - prefetch_all_fields_gpu_only
  - compute_vertices:
     resize_vertex: true
compute_fast_vertices: 
  - compute_vertices:
     resize_vertex: false

reorder_extra_data: nop

### IO
particle_write_paraview_generic:
  - write_paraview_polyhedra_pvtu
  - write_paraview_obb_particles

# read_dump_particle_interaction [input file]
write_dump_particle_op: write_dump_particle_interaction

contact_network: dump_contact_network
