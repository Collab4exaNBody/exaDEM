# nbh_polyhedron_gpu must build exactly the same interactions (and history) as nbh_polyhedron.
# This is the default tested path of config_compare_nbh_gpu.msp: nothing to override.
compare_nbh_polyhedron:
  body:
    - compare_classifiers:
       atol: 1e-12
       rtol: 1e-9
       abort_on_error: true
