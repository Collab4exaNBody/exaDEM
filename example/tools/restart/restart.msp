includes:
  - common.msp

io_tree:
  - io_config:
     dir_name: "RestartTestDir"

input_data:
  - restart

domain:
  cell_size: 2.0
  periodic: [false,false,false]
  grid_dims: [3, 3, 3]
  bounds: [[0,0,0], [6,6,6]]
  expandable: true

global:
  simulation_dump_frequency: -1
  simulation_end_iteration: 20
  simulation_log_frequency: 5
  simulation_paraview_frequency: -1
  dt: 0.0005 s
  rcut_inc: 0.4
