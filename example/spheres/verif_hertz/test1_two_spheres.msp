# Hertz verification, test 1 of Chung & Ooi (2011): elastic (e=1) head-on impact of
# two identical spheres (R = 1 cm, +/-10 m/s), two independent pairs, materials of
# Table 2 of the paper, one Young modulus / Poisson ratio per material:
#   group 0: Glass      E = 48 GPa, nu = 0.20, rho = 2800 kg/m3
#   group 1: Limestone  E = 20 GPa, nu = 0.25, rho = 2500 kg/m3
# Reference: Table 3 of the paper (Hertz) and the numerical solution of the impact
# (hertz_lib.py). Checked by check_hertz.py.
grid_flavor: grid_flavor_dem

includes:
  - config_spheres.msp

io_tree:
  - io_config:
     dir_name: "VerifHertzTest1Dir"

input_data:
  - particle_type:
     type: [ GlassA, GlassB, LimeA, LimeB ]
  - read_xyz:
     file: test1_two_spheres.xyz
     bounds_mode: FILE
  - set_fields:
     polyhedra: false
     type:     [     GlassA,      GlassB,       LimeA,       LimeB ]
     group:    [          0,           0,           1,           1 ]
     radius:   [       0.01,        0.01,        0.01,        0.01 ]
     density:  [       2800,        2800,        2500,        2500 ]
     velocity: [ [10, 0, 0], [-10, 0, 0], [10, 0, 0], [-10, 0, 0] ]
  - multimat_contact_params_hertz:
     group1:   [          0,           1 ]
     group2:   [          0,           1 ]
     young:    [      48.e9,       20.e9 ]
     poisson:  [       0.20,        0.25 ]
     kt:       [          0,           0 ]
     kr:       [          0,           0 ]
     mu:       [          0,           0 ]
     damprate: [          0,           0 ]

compute_force:
  # no gravity (as in the paper)
  - contact_sphere_hertz_none

domain:
  cell_size: 0.02 m
  periodic: [false, false, false]
  bounds: [[0, 0, 0], [0.08, 0.14, 0.04]]
  # explicit grid_dims: bounds/cell_size is truncated, not rounded
  grid_dims: [4, 7, 2]

global:
  simulation_dump_frequency: -1
  simulation_end_iteration: 700
  simulation_log_frequency: 100
  simulation_paraview_frequency: 5
  analysis_interaction_dump_frequency: 1
  dt: 1.e-7 s
  rcut_inc: 0.002 m
