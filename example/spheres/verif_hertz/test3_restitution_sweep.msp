# Hertz verification, test 3 of Chung & Ooi (2011): normal impact with different
# restitution coefficients. Four identical Al. oxide spheres (R = 2.5 mm,
# E = 380 GPa, nu = 0.23, rho = 4000 kg/m3) on a rigid plane at 3.9 m/s, one group
# per damp_rate. The spheres start touching the plane and never touch each other.
# With the damping of the Hertz law (c = 2 damp_rate sqrt(m k), k = 2 E* sqrt(R delta)),
# e only depends on damp_rate; the values below give e = 0.9, 0.7, 0.5, 0.3
# (hertz_lib.damp_rate_for_restitution). Expected rebound velocity: e * 3.9 m/s.
# Checked by check_hertz.py.
grid_flavor: grid_flavor_dem

includes:
  - config_spheres.msp

io_tree:
  - io_config:
     dir_name: "VerifHertzTest3Dir"

input_data:
  - particle_type:
     type: [ Sphere0, Sphere1, Sphere2, Sphere3 ]
  - read_xyz:
     file: test3_restitution_sweep.xyz
     bounds_mode: FILE
  - set_fields:
     polyhedra: false
     type:     [        Sphere0,        Sphere1,        Sphere2,        Sphere3 ]
     group:    [              0,              1,              2,              3 ]
     radius:   [         0.0025,         0.0025,         0.0025,         0.0025 ]
     density:  [           4000,           4000,           4000,           4000 ]
     velocity: [ [0,0,-3.9],     [0,0,-3.9],     [0,0,-3.9],     [0,0,-3.9]     ]
  # material of the groups (no particle-particle contact in this test)
  - multimat_contact_params_hertz:
     default_config: { young: 380.e9, poisson: 0.23, kt: 0, kr: 0, mu: 0, damp_rate: 0 }
     young:   [ 380.e9, 380.e9, 380.e9, 380.e9 ]
     poisson: [   0.23,   0.23,   0.23,   0.23 ]
  - drivers_contact_params_hertz:
     group:     [         0,         1,         2,         3 ]
     driver_id: [         0,         0,         0,         0 ]
     kt:        [         0,         0,         0,         0 ]
     kr:        [         0,         0,         0,         0 ]
     mu:        [         0,         0,         0,         0 ]
     damprate:  [ 0.0312797, 0.1115664, 0.2330340, 0.4539161 ]  # e = 0.9, 0.7, 0.5, 0.3
     driver_young:   [ 1.e40 ]  # rigid plane
     driver_poisson: [     0 ]

setup_drivers:
  - register_surface:
     id: 0
     state: { normal: [0, 0, 1], offset: 0 }
     params: { motion_type: STATIONARY }

compute_force:
  # no gravity (as in the paper)
  - contact_sphere_hertz_none

domain:
  cell_size: 0.01 m
  periodic: [false, false, false]
  grid_dims: [9, 2, 2]

global:
  simulation_dump_frequency: -1
  simulation_end_iteration: 2000
  simulation_log_frequency: 500
  simulation_paraview_frequency: 20
  analysis_interaction_dump_frequency: 1
  dt: 5.e-9 s
  rcut_inc: 0.002 m
