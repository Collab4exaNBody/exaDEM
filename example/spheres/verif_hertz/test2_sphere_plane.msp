# Hertz verification, test 2 of Chung & Ooi (2011): elastic (e=1) normal impact of
# a sphere (Al. alloy, R = 0.1 m, E = 70 GPa, nu = 0.30, rho = 2699 kg/m3) on a rigid
# plane at 0.2 m/s. The sphere starts touching the plane (zero gap).
# Rigid plane: E* = E / (1 - nu^2) (very large Young modulus of the plane).
# Reference: Table 3 of the paper (Hertz) and the numerical solution of the impact
# (hertz_lib.py). Checked by check_hertz.py.
grid_flavor: grid_flavor_dem

includes:
  - config_spheres.msp

io_tree:
  - io_config:
     dir_name: "VerifHertzTest2Dir"

input_data:
  - particle_type:
     type: [ Sphere ]
  - read_xyz:
     file: test2_sphere_plane.xyz
     bounds_mode: DOMAIN
  - set_fields:
     polyhedra: false
     type:     [        Sphere ]
     group:    [             0 ]
     radius:   [           0.1 ]
     density:  [          2699 ]
     velocity: [ [0, 0, -0.2] ]
  # material of the sphere (no particle-particle contact in this test)
  - multimat_contact_params_hertz:
     group1:   [     0 ]
     group2:   [     0 ]
     young:    [ 70.e9 ]
     poisson:  [  0.30 ]
     kt:       [     0 ]
     kr:       [     0 ]
     mu:       [     0 ]
     damprate: [     0 ]
  - drivers_contact_params_hertz:
     group:          [     0 ]
     driver_id:      [     0 ]
     kt:             [     0 ]
     kr:             [     0 ]
     mu:             [     0 ]
     damprate:       [     0 ]
     driver_young:   [ 1.e40 ]  # rigid plane
     driver_poisson: [     0 ]

setup_drivers:
  - register_surface:
     id: 0
     state: { normal: [0, 0, 1], offset: 0 }
     params: { motion_type: STATIONARY }

compute_force:
  # no gravity (as in the paper)
  - contact_sphere_hertz_none

domain:
  # cell_size must be well above 2*radius
  cell_size: 0.25 m
  periodic: [false, false, false]
  bounds: [[0, 0, 0], [0.5, 0.5, 0.5]]
  grid_dims: [2, 2, 2]

global:
  simulation_dump_frequency: -1
  simulation_end_iteration: 1000
  simulation_log_frequency: 100
  simulation_paraview_frequency: 10
  analysis_interaction_dump_frequency: 1
  dt: 1.e-6 s
  rcut_inc: 0.002 m
